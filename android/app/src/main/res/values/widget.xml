<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's light tokens, from lib/core/theme/app_colors.dart. -->
    <color name="widget_surface">#E3E9EF</color>
    <color name="widget_well">#D7DFE7</color>
    <color name="widget_ink">#1E2830</color>
    <color name="widget_muted">#545E68</color>
    <color name="widget_primary">#0C5F96</color>
    <color name="widget_on_primary">#FFFFFF</color>

    <string name="widget_title">bajet</string>
    <string name="widget_log">+ Log</string>
    <string name="widget_empty">Open bajet to set up your week</string>
    <string name="widget_description">What is left of the week, and a tap to log</string>

    <style name="WidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WidgetButton.Primary">
        <item name="android:background">@drawable/widget_button_primary</item>
        <item name="android:textColor">@color/widget_on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
